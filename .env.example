# Copy to .env and fill in only what you use. Never commit .env.
# config.yaml names the variable for each provider (`api_key_env`); the value
# itself is only ever read from the environment.

# --- LLM -----------------------------------------------------------------
ANTHROPIC_API_KEY=
# Also used by the OpenAI-compatible LLM adapter and OpenAI TTS.
# Self-hosted servers (vLLM, LM Studio, Ollama) need no key at all.
OPENAI_API_KEY=

# --- TTS -----------------------------------------------------------------
# Metered per character. `tts.elevenlabs.max_characters_per_job` in config.yaml
# caps what one job can spend.
#
# Several keys are supported so a job survives one running out of credit. Either
# list them here comma-separated:
#     ELEVENLABS_API_KEY=sk_first,sk_second,sk_third
# or use separate variables and name them in config.yaml under `api_key_envs`.
# Rotation is automatic; `active_key` pins one deliberately.
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_2=
ELEVENLABS_API_KEY_3=

# --- Visuals -------------------------------------------------------------
# Optional. Stock photography and footage for the reel's pictures, in place of
# a ComfyUI server. Free from https://www.pexels.com/api/ -- 200 requests an
# hour, and a reel spends one per picture, so roughly forty reels an hour.
PEXELS_API_KEY=

# --- Ingest --------------------------------------------------------------
# Optional. Raises the GitHub API rate limit from 60 to 5000 requests an hour.
GITHUB_TOKEN=
# Optional. Only needed for gated Hugging Face repositories.
HUGGINGFACE_TOKEN=

# --- Docker ---------------------------------------------------------------
# Which interface the app is published on. Default 127.0.0.1: reachable from
# the machine itself and nowhere else.
#
# Widen it deliberately, because only /api/settings is guarded -- publishing
# this port also exposes the jobs API (including artifact download), the
# queue, and the provider key balances to anything that can route to the box.
#
#   REELFORGE_BIND=0.0.0.0       every interface
#   REELFORGE_BIND=100.x.y.z     one address, e.g. this host on a tailnet
#
# Compose reads this file for it only because the documented command passes
# `--env-file .env`; without that flag compose looks beside the compose file
# instead and the setting is silently ignored.
REELFORGE_BIND=

# Who the containers run as. Normally nothing to do: they start as root, take
# ownership of the bind-mounted ./data from whoever owns it on the host, and
# drop privileges before running anything -- so reels come out belonging to
# you with no setup. Set these only to force a specific user.
REELFORGE_UID=
REELFORGE_GID=

# --- Administration ------------------------------------------------------
# The settings API accepts API keys. Leave this empty and settings can only be
# changed from the machine itself; set it and EVERY client must present it as
# a bearer token -- including a browser on this machine, which asks for it on
# the Settings page and keeps it locally.
#
# It guards /api/settings only. Jobs, the queue, artifact download and the
# provider key balances stay open to anyone who can reach the port, so widen
# REELFORGE_BIND with that in mind.
REELFORGE_ADMIN_TOKEN=

# --- Overrides -----------------------------------------------------------
# Any config.yaml value: REELFORGE_<SECTION>__<KEY>
# REELFORGE_LLM__PROVIDER=openai
# REELFORGE_TTS__PROVIDER=elevenlabs
# REELFORGE_RENDER__WORKERS=4
