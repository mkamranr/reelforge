# Compose's own variables, read from beside the compose file.
#
# This is a different file from the repository root's `.env`, and the
# distinction is not cosmetic: compose interpolates `${...}` in the compose
# file from HERE (its project directory), while `../.env` is passed through
# to the containers as their environment. A value put in the wrong one is
# silently ignored.
#
#     cp docker/.env.example docker/.env
#
# --- Which interface the app is published on -----------------------------
# Default 127.0.0.1: reachable from the machine itself and nowhere else.
#
# Widen it deliberately, because only /api/settings is guarded -- publishing
# this port also exposes the jobs API (including artifact download), the
# queue, and the provider key balances to anything that can route to the box.
#
#   REELFORGE_BIND=0.0.0.0       every interface
#   REELFORGE_BIND=100.x.y.z     one address, e.g. this host on a tailnet
#
# Set REELFORGE_ADMIN_TOKEN in ../.env at the same time -- that is a secret
# and belongs in the root file, not this one.
REELFORGE_BIND=
